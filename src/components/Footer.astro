---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const whatsappDisplay = 'Mawa Center';
const whatsappHref = 'https://wa.me/6281393750612?text=Assalamualaikum%2C%20saya%20ingin%20bertanya%20tentang%20Pondok%20Pesantren%20Mambaul%20Hikmah.';

const quickLinks = [
	{ label: 'Beranda Utama', href: '/' },
	{ label: 'Tentang Kami', href: '/tentang-kami' },
	{ label: 'Blog & Berita', href: '/blog' },
	{ label: 'Info Pendaftaran', href: '/info-pendaftaran' },
	{ label: 'Portal SMART (Login)', href: 'https://smart.mambaulhikmah.com' },
];

const educationalUnits = [
	{ name: 'STIT Mambaul Hikmah', href: 'https://pmb-stit.mambaulhikmah.com' },
	{ name: 'MA Mambaul Hikmah', href: '/info-pendaftaran' },
	{ name: 'MTs Mambaul Hikmah', href: '/info-pendaftaran' },
	{ name: 'MI Mambaul Hikmah', href: '/info-pendaftaran' },
	{ name: 'Ulya Mambaul Hikmah', href: '/info-pendaftaran' },
	{ name: 'RA Mambaul Hikmah', href: '/info-pendaftaran' },
	{ name: 'PAUD Mambaul Hikmah', href: '/info-pendaftaran' },
];
---

<footer class="site-footer" id="kontak">
	<!-- Background Glow Accents -->
	<div class="footer-glow glow-1"></div>
	<div class="footer-glow glow-2"></div>

	<div class="footer-container">
		<div class="footer-grid">
			<!-- Col 1: Brand & Profile -->
			<div class="footer-col brand-col">
				<a class="footer-brand" href="/" aria-label="Beranda Pondok Pesantren Mambaul Hikmah">
					<div class="logo-box">
						<Image src={logo} width={56} height={56} alt="Logo Pondok Pesantren Mambaul Hikmah" loading="lazy" />
					</div>
					<div class="brand-info">
						<strong>Mambaul Hikmah</strong>
						<small>Pondok Pesantren • Tegal</small>
					</div>
				</a>

				<p class="brand-desc">
					Lembaga pendidikan Islam terpadu yang berkomitmen membimbing santri beriman, bertakwa, berilmu, dan berakhlak mulia melalui tradisi Al-Qur'an & Kitab Salaf.
				</p>

				<div class="social-links">
					<a href={whatsappHref} target="_blank" rel="noreferrer" class="social-btn wa" aria-label="WhatsApp Admin">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
							<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
						</svg>
					</a>
					<a href="https://www.youtube.com/@MawaTvTegal" target="_blank" rel="noreferrer" class="social-btn yt" aria-label="YouTube Channel">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
							<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
						</svg>
					</a>
					<a href="https://www.instagram.com/ponpesmawa/" target="_blank" rel="noreferrer" class="social-btn ig" aria-label="Instagram">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
							<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
							<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
						</svg>
					</a>
					<a href="https://www.facebook.com/MambaulHikmahTegal/" target="_blank" rel="noreferrer" class="social-btn fb" aria-label="Facebook">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
							<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
						</svg>
					</a>
				</div>
			</div>

			<!-- Col 2: Quick Links -->
			<div class="footer-col">
				<h3 class="col-title">Navigasi Cepat</h3>
				<ul class="footer-links">
					{
						quickLinks.map((link) => (
							<li>
								<a href={link.href}>
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="9 18 15 12 9 6"></polyline>
									</svg>
									<span>{link.label}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Col 3: Unit Pendidikan -->
			<div class="footer-col">
				<h3 class="col-title">Unit Pendidikan</h3>
				<ul class="footer-links">
					{
						educationalUnits.map((unit) => (
							<li>
								<a href={unit.href}>
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
										<polyline points="9 18 15 12 9 6"></polyline>
									</svg>
									<span>{unit.name}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Col 4: Kontak & Lokasi -->
			<div class="footer-col contact-col">
				<h3 class="col-title">Kontak & Alamat</h3>
				<div class="contact-list">
					<div class="contact-item">
						<div class="contact-icon">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
								<circle cx="12" cy="10" r="3"></circle>
							</svg>
						</div>
						<div class="contact-text">
							<strong>Lokasi Pesantren</strong>
							<p>Desa Tegalwangi, Kecamatan Talang, Kabupaten Tegal, Jawa Tengah 52193</p>
						</div>
					</div>

					<div class="contact-item">
						<div class="contact-icon">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
						</div>
						<div class="contact-text">
							<strong>WhatsApp Admin</strong>
							<a href={whatsappHref} target="_blank" rel="noreferrer">{whatsappDisplay}</a>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Footer Bottom Bar -->
		<div class="footer-bottom">
			<div class="motto-badge">
				<span>Motto:</span>
				<strong>Ilmu • Amal • Tazkiyah</strong>
			</div>
			
			<p class="copyright">
				© {new Date().getFullYear()} Pondok Pesantren Mambaul Hikmah Tegalwangi. Hak Cipta Dilindungi.
			</p>

			<button id="back-to-top" class="back-to-top" aria-label="Kembali ke Atas">
				<span>Ke Atas</span>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="12" y1="19" x2="12" y2="5"></line>
					<polyline points="5 12 12 5 19 12"></polyline>
				</svg>
			</button>
		</div>
	</div>
</footer>

<script>
	const backToTopBtn = document.getElementById('back-to-top');
	backToTopBtn?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});
</script>

<style>
	.site-footer {
		position: relative;
		background: linear-gradient(175deg, #022625 0%, #033a38 50%, #011d1c 100%);
		color: #e0ecec;
		padding: 72px 0 32px;
		overflow: hidden;
	}

	.footer-glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(120px);
		pointer-events: none;
	}

	.glow-1 {
		top: -100px;
		left: -100px;
		width: 400px;
		height: 400px;
		background: rgba(0, 150, 140, 0.12);
	}

	.glow-2 {
		bottom: -100px;
		right: -100px;
		width: 500px;
		height: 500px;
		background: rgba(212, 175, 55, 0.08);
	}

	.footer-container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 clamp(20px, 4vw, 48px);
		position: relative;
		z-index: 2;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 0.9fr 1fr 1.3fr;
		gap: clamp(28px, 4vw, 48px);
		margin-bottom: 60px;
	}

	/* Brand Col */
	.brand-col {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 14px;
		text-decoration: none;
		color: #ffffff;
	}

	.logo-box {
		width: 52px;
		height: 52px;
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.1);
		padding: 6px;
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.15);
	}

	.logo-box img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.brand-info {
		display: flex;
		flex-direction: column;
	}

	.brand-info strong {
		font-size: 1.15rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: -0.01em;
	}

	.brand-info small {
		font-size: 0.75rem;
		color: #84b2b0;
		font-weight: 600;
	}

	.brand-desc {
		font-size: 0.9rem;
		line-height: 1.7;
		color: #9cbaba;
		margin: 0;
	}

	.social-links {
		display: flex;
		gap: 10px;
		margin-top: 6px;
	}

	.social-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.06);
		color: #b0d4d2;
		border: 1px solid rgba(255, 255, 255, 0.08);
		transition: all 0.25s ease;
		text-decoration: none;
	}

	.social-btn:hover {
		transform: translateY(-3px);
		color: #ffffff;
	}

	.social-btn.wa:hover { background: #25d366; border-color: #25d366; }
	.social-btn.yt:hover { background: #ff0000; border-color: #ff0000; }
	.social-btn.ig:hover { background: #e1306c; border-color: #e1306c; }
	.social-btn.fb:hover { background: #1877f2; border-color: #1877f2; }

	/* Column Styling */
	.col-title {
		font-size: 1rem;
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 20px;
		position: relative;
		padding-bottom: 10px;
	}

	.col-title::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 32px;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(90deg, #d4af37, transparent);
	}

	.footer-links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-links a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: #9cbaba;
		font-size: 0.88rem;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.footer-links a svg {
		color: #d4af37;
		transition: transform 0.2s ease;
	}

	.footer-links a:hover {
		color: #ffffff;
		transform: translateX(4px);
	}

	.footer-links a:hover svg {
		transform: translateX(2px);
	}

	/* Contact Col */
	.contact-list {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.contact-item {
		display: flex;
		gap: 12px;
	}

	.contact-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: rgba(212, 175, 55, 0.12);
		color: #e5c158;
		flex-shrink: 0;
	}

	.contact-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.contact-text strong {
		font-size: 0.82rem;
		color: #ffffff;
		font-weight: 700;
	}

	.contact-text p,
	.contact-text a {
		font-size: 0.86rem;
		color: #9cbaba;
		line-height: 1.5;
		margin: 0;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.contact-text a:hover {
		color: #d4af37;
	}

	/* Bottom Bar */
	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 28px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		gap: 20px;
		flex-wrap: wrap;
	}

	.motto-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 16px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 0.8rem;
	}

	.motto-badge span {
		color: #84b2b0;
	}

	.motto-badge strong {
		color: #d4af37;
		font-weight: 700;
	}

	.copyright {
		font-size: 0.84rem;
		color: #7b9e9c;
		margin: 0;
	}

	.back-to-top {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.05);
		color: #d4af37;
		font-size: 0.8rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.25s ease;
	}

	.back-to-top:hover {
		background: #d4af37;
		color: #022625;
		border-color: #d4af37;
		transform: translateY(-2px);
	}

	@media (max-width: 1100px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 640px) {
		.site-footer {
			padding: 48px 0 24px;
		}

		.footer-grid {
			grid-template-columns: 1fr;
			gap: 36px;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
