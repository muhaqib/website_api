---
const phone = '+62 813-9375-0612';
const href =
	'https://wa.me/6281393750612?text=Assalamualaikum%2C%20saya%20ingin%20bertanya%20tentang%20Pondok%20Pesantren%20Mambaul%20Hikmah.';
---

<a class="whatsapp-cta" href={href} target="_blank" rel="noreferrer" aria-label={`Chat WhatsApp ${phone}`}>
	<span class="social-btn wa" aria-hidden="true">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
			<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
		</svg>
	</span>
	<span class="wa-text">
		<small>Chat Admin</small>
		<strong>WhatsApp</strong>
	</span>
</a>

<style>
	.whatsapp-cta {
		position: fixed;
		right: clamp(16px, 3vw, 34px);
		bottom: clamp(16px, 3vw, 34px);
		z-index: 60;
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 8px 16px 8px 8px;
		border-radius: 999px;
		background: rgba(0, 77, 76, 0.92);
		color: #ffffff;
		box-shadow: 0 24px 48px -24px rgba(25, 28, 29, 0.42), 0 4px 16px rgba(37, 211, 102, 0.2);
		text-decoration: none;
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		animation: waFloat 760ms cubic-bezier(0.2, 0.8, 0.2, 1) both 420ms;
	}

	.social-btn.wa {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: #25d366;
		color: #ffffff;
		flex-shrink: 0;
		box-shadow: 0 4px 12px rgba(37, 211, 102, 0.4);
		transition: transform 0.25s ease;
	}

	.wa-text {
		display: grid;
		line-height: 1.1;
	}

	.wa-text small {
		color: rgba(255, 255, 255, 0.74);
		font-size: 0.72rem;
		font-weight: 800;
	}

	.wa-text strong {
		margin-top: 3px;
		font-size: 0.9rem;
	}

	.whatsapp-cta:hover {
		transform: translateY(-2px);
		background: rgba(0, 77, 76, 0.98);
		box-shadow: 0 28px 56px -20px rgba(25, 28, 29, 0.5), 0 6px 20px rgba(37, 211, 102, 0.35);
	}

	.whatsapp-cta:hover .social-btn.wa {
		transform: scale(1.08) rotate(-5deg);
	}

	@keyframes waFloat {
		from {
			opacity: 0;
			transform: translateY(18px) scale(0.96);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 620px) {
		.whatsapp-cta {
			right: 14px;
			bottom: 14px;
			padding: 6px;
		}

		.wa-text {
			display: none;
		}
	}
</style>

