---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const pathname = Astro.url.pathname;

const navItems = [
	{ label: 'Beranda', href: '/' },
	{ label: 'Blog & Berita', href: '/blog' },
	{ label: 'Tentang Kami', href: '/tentang-kami' },
	{ label: 'Info Pendaftaran', href: '/info-pendaftaran' },
];

function isActive(href: string) {
	if (href === '/') {
		return pathname === '/';
	}
	return pathname.startsWith(href);
}
---

<header class="site-header">
	<div class="header-container">
		<a class="brand" href="/" aria-label="Beranda Pondok Pesantren Mambaul Hikmah">
			<div class="logo-wrapper">
				<Image src={logo} width={52} height={52} alt="Logo Pondok Pesantren Mambaul Hikmah" loading="eager" />
			</div>
			<div class="brand-text">
				<strong>Mambaul Hikmah</strong>
				<small>Tegalwangi • Talang • Tegal</small>
			</div>
		</a>

		<nav class="desktop-nav" aria-label="Navigasi Utama">
			{
				navItems.map((item) => (
					<a href={item.href} class={isActive(item.href) ? 'active' : ''}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="header-actions">
			<a class="btn btn-ghost" href="https://smart.mambaulhikmah.com" target="_blank" rel="noreferrer">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
					<polyline points="10 17 15 12 10 7"></polyline>
					<line x1="15" y1="12" x2="3" y2="12"></line>
				</svg>
				<span>Login SMART</span>
			</a>
			<a class="btn btn-primary" href="/info-pendaftaran">
				<span>Daftar Santri</span>
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="5" y1="12" x2="19" y2="12"></line>
					<polyline points="12 5 19 12 12 19"></polyline>
				</svg>
			</a>
		</div>

		<button class="mobile-toggle" id="mobile-toggle" aria-label="Buka Menu Navigasi" aria-expanded="false">
			<svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<line x1="4" y1="6" x2="20" y2="6"></line>
				<line x1="4" y1="12" x2="20" y2="12"></line>
				<line x1="4" y1="18" x2="20" y2="18"></line>
			</svg>
			<svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>

	<!-- Mobile Drawer -->
	<div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
		<div class="drawer-backdrop" id="drawer-backdrop"></div>
		<div class="drawer-content">
			<div class="drawer-header">
				<div class="brand">
					<Image src={logo} width={40} height={40} alt="" />
					<div class="brand-text">
						<strong>Mambaul Hikmah</strong>
						<small>Pondok Pesantren</small>
					</div>
				</div>
			</div>
			<nav class="mobile-nav">
				{
					navItems.map((item) => (
						<a href={item.href} class={isActive(item.href) ? 'active' : ''}>
							<span>{item.label}</span>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</a>
					))
				}
			</nav>
			<div class="drawer-actions">
				<a class="btn btn-primary btn-full" href="/info-pendaftaran">
					<span>Daftar Santri Baru</span>
				</a>
				<a class="btn btn-ghost btn-full" href="https://smart.mambaulhikmah.com" target="_blank" rel="noreferrer">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
						<polyline points="10 17 15 12 10 7"></polyline>
						<line x1="15" y1="12" x2="3" y2="12"></line>
					</svg>
					<span>Login Portal SMART</span>
				</a>
			</div>
		</div>
	</div>
</header>

<script>
	const toggleBtn = document.getElementById('mobile-toggle');
	const drawer = document.getElementById('mobile-drawer');
	const backdrop = document.getElementById('drawer-backdrop');

	function toggleMenu(show?: boolean) {
		const isOpened = drawer?.classList.contains('is-active');
		const newState = show !== undefined ? show : !isOpened;

		if (newState) {
			drawer?.classList.add('is-active');
			toggleBtn?.classList.add('is-active');
			toggleBtn?.setAttribute('aria-expanded', 'true');
			drawer?.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
		} else {
			drawer?.classList.remove('is-active');
			toggleBtn?.classList.remove('is-active');
			toggleBtn?.setAttribute('aria-expanded', 'false');
			drawer?.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
		}
	}

	toggleBtn?.addEventListener('click', () => toggleMenu());
	backdrop?.addEventListener('click', () => toggleMenu(false));
</script>

<style>
	.site-header {
		position: fixed;
		top: clamp(12px, 2vw, 22px);
		right: clamp(16px, 4vw, 56px);
		left: clamp(16px, 4vw, 56px);
		z-index: 100;
	}

	.header-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 10px 18px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid rgba(220, 230, 230, 0.8);
		box-shadow: 
			0 12px 32px -12px rgba(0, 77, 76, 0.12),
			0 4px 16px rgba(0, 0, 0, 0.03);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		animation: headerDrop 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		color: inherit;
		min-width: 0;
	}

	.logo-wrapper {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: linear-gradient(135deg, rgba(0, 77, 76, 0.08), rgba(212, 175, 55, 0.12));
		padding: 4px;
		transition: transform 0.3s ease;
	}

	.brand:hover .logo-wrapper {
		transform: scale(1.05) rotate(-2deg);
	}

	.brand img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
	}

	.brand-text strong {
		color: #004d4c;
		font-family: 'Manrope', 'Inter', system-ui, sans-serif;
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.01em;
		line-height: 1.15;
		white-space: nowrap;
	}

	.brand-text small {
		color: #596465;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 4px;
		background: rgba(240, 245, 245, 0.6);
		border-radius: 999px;
		border: 1px solid rgba(0, 77, 76, 0.06);
	}

	.desktop-nav a {
		position: relative;
		padding: 8px 18px;
		border-radius: 999px;
		color: #465354;
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.desktop-nav a:hover {
		color: #004d4c;
		background: rgba(255, 255, 255, 0.8);
	}

	.desktop-nav a.active {
		color: #ffffff;
		background: #004d4c;
		box-shadow: 0 4px 12px rgba(0, 77, 76, 0.25);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		height: 40px;
		padding: 0 18px;
		border-radius: 999px;
		font-size: 0.86rem;
		font-weight: 800;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		cursor: pointer;
		white-space: nowrap;
	}

	.btn-primary {
		background: linear-gradient(135deg, #004d4c 0%, #006664 100%);
		color: #ffffff;
		box-shadow: 0 4px 14px rgba(0, 77, 76, 0.28);
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(0, 77, 76, 0.38);
		background: linear-gradient(135deg, #003a39 0%, #005452 100%);
	}

	.btn-ghost {
		color: #004d4c;
		background: rgba(0, 77, 76, 0.06);
	}

	.btn-ghost:hover {
		background: rgba(0, 77, 76, 0.12);
		transform: translateY(-1px);
	}

	/* Mobile Toggle Button */
	.mobile-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: none;
		background: rgba(0, 77, 76, 0.08);
		color: #004d4c;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.mobile-toggle:hover {
		background: rgba(0, 77, 76, 0.15);
	}

	.mobile-toggle .icon-close {
		display: none;
	}

	.mobile-toggle.is-active .icon-open {
		display: none;
	}

	.mobile-toggle.is-active .icon-close {
		display: block;
	}

	/* Mobile Drawer */
	.mobile-drawer {
		position: fixed;
		inset: 0;
		z-index: 99;
		visibility: hidden;
		pointer-events: none;
		transition: visibility 0.3s ease;
	}

	.mobile-drawer.is-active {
		visibility: visible;
		pointer-events: auto;
	}

	.drawer-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(10, 25, 25, 0.5);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.mobile-drawer.is-active .drawer-backdrop {
		opacity: 1;
	}

	.drawer-content {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: min(85vw, 360px);
		background: #ffffff;
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 24px;
		transform: translateX(100%);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: -10px 0 30px rgba(0, 0, 0, 0.15);
	}

	.mobile-drawer.is-active .drawer-content {
		transform: translateX(0);
	}

	.drawer-header {
		padding-bottom: 16px;
		border-bottom: 1px solid #eef2f2;
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: 1;
	}

	.mobile-nav a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 18px;
		border-radius: 14px;
		color: #334141;
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		background: #f7f9f9;
		transition: all 0.2s ease;
	}

	.mobile-nav a:hover,
	.mobile-nav a.active {
		background: linear-gradient(135deg, rgba(0, 77, 76, 0.08), rgba(212, 175, 55, 0.08));
		color: #004d4c;
		padding-left: 22px;
	}

	.drawer-actions {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-top: 16px;
		border-top: 1px solid #eef2f2;
	}

	.btn-full {
		width: 100%;
		height: 46px;
		border-radius: 14px;
		font-size: 0.92rem;
	}

	@keyframes headerDrop {
		from {
			opacity: 0;
			transform: translateY(-20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 1024px) {
		.desktop-nav,
		.header-actions {
			display: none;
		}

		.mobile-toggle {
			display: flex;
		}

		.header-container {
			padding: 8px 14px;
		}

		.brand-text small {
			display: none;
		}
	}

	@media (max-width: 480px) {
		.site-header {
			top: 10px;
			left: 10px;
			right: 10px;
		}

		.brand-text strong {
			font-size: 0.95rem;
		}
	}
</style>
