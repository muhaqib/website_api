---
import Layout from '../layouts/Layout.astro';
import { whatsappDisplay, whatsappHref } from '../data/site';
---

<Layout
	title="Info Pendaftaran - Pondok Pesantren Mambaul Hikmah"
	description="Informasi penerimaan santri baru Pondok Pesantren Mambaul Hikmah Tegalwangi."
>
	<main class="page">
		<div class="ambient-glow glow-top"></div>
		<div class="ambient-glow glow-bottom"></div>

		<section class="pendaftaran-container">
			<div class="notice-card">
				<div class="notice-badge">
					<span class="badge-pulse"></span>
					<span>Pengumuman Pendaftaran</span>
				</div>

				<h1>Pendaftaran Online Belum Dibuka</h1>

				<div class="callout-box">
					<svg class="callout-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="8" x2="12" y2="12"></line>
						<line x1="12" y1="16" x2="12.01" y2="16"></line>
					</svg>
					<p class="notice-text">
						Mohon maaf, pendaftaran santri baru secara online untuk saat ini <strong>belum dibuka</strong>. Informasi persyaratan, jadwal pendaftaran, dan konsultasi unit dapat ditanyakan langsung kepada panitia atau dengan mengunjungi kantor <strong>Mawa Center</strong>.
					</p>
				</div>

				<div class="info-grid">
					<div class="info-card">
						<div class="info-icon office-icon">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
								<circle cx="12" cy="10" r="3"></circle>
							</svg>
						</div>
						<div class="info-body">
							<span class="info-label">Sekretariat Pendaftaran</span>
							<strong class="info-title">Kantor Mawa Center</strong>
							<p class="info-desc">Pondok Pesantren Mambaul Hikmah Tegalwangi, Talang, Kabupaten Tegal</p>
						</div>
					</div>
				</div>

				<div class="actions">
					<a class="btn btn-primary" href={whatsappHref} target="_blank" rel="noopener noreferrer">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
							<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
						</svg>
						<span>Hubungi Mawa Center via WhatsApp</span>
					</a>
					<a class="btn btn-secondary" href="/">
						<span>Kembali ke Halaman Utama</span>
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.page {
		position: relative;
		min-height: 88vh;
		background:
			radial-gradient(circle at 50% 0%, rgba(0, 103, 102, 0.08) 0%, transparent 60%),
			linear-gradient(180deg, #f4f8f8 0%, #ebf2f2 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 150px 20px 90px;
		overflow: hidden;
	}

	.ambient-glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(100px);
		pointer-events: none;
		z-index: 1;
	}

	.glow-top {
		top: -120px;
		left: 50%;
		transform: translateX(-50%);
		width: 500px;
		height: 300px;
		background: rgba(0, 103, 102, 0.12);
	}

	.glow-bottom {
		bottom: -100px;
		right: 10%;
		width: 400px;
		height: 250px;
		background: rgba(200, 155, 60, 0.08);
	}

	.pendaftaran-container {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 680px;
		margin: 0 auto;
	}

	.notice-card {
		padding: clamp(32px, 6vw, 52px);
		border-radius: 32px;
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(20px);
		border: 1px solid rgba(0, 77, 76, 0.12);
		box-shadow:
			0 24px 60px -15px rgba(0, 77, 76, 0.12),
			0 0 0 1px rgba(255, 255, 255, 0.8) inset;
		text-align: center;
		animation: cardEntrance 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@keyframes cardEntrance {
		from {
			opacity: 0;
			transform: translateY(24px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	.notice-badge {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 7px 18px;
		border-radius: 999px;
		background: rgba(0, 77, 76, 0.07);
		border: 1px solid rgba(0, 77, 76, 0.15);
		color: #005a59;
		font-size: 0.82rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		margin-bottom: 24px;
	}

	.badge-pulse {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #c89b3c;
		box-shadow: 0 0 0 0 rgba(200, 155, 60, 0.5);
		animation: pulseDot 2s infinite;
	}

	@keyframes pulseDot {
		0% {
			transform: scale(0.95);
			box-shadow: 0 0 0 0 rgba(200, 155, 60, 0.6);
		}
		70% {
			transform: scale(1);
			box-shadow: 0 0 0 8px rgba(200, 155, 60, 0);
		}
		100% {
			transform: scale(0.95);
			box-shadow: 0 0 0 0 rgba(200, 155, 60, 0);
		}
	}

	h1 {
		margin: 0 0 20px;
		color: #004d4c;
		font-family: Manrope, Inter, ui-sans-serif, system-ui, sans-serif;
		font-size: clamp(1.85rem, 4vw, 2.4rem);
		font-weight: 850;
		line-height: 1.2;
		letter-spacing: -0.03em;
	}

	.callout-box {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		padding: 18px 22px;
		border-radius: 20px;
		background: rgba(200, 155, 60, 0.06);
		border: 1px solid rgba(200, 155, 60, 0.22);
		border-left: 5px solid #c89b3c;
		margin-bottom: 34px;
		text-align: left;
	}

	.callout-icon {
		color: #b38526;
		flex-shrink: 0;
		margin-top: 2px;
	}

	.notice-text {
		margin: 0;
		color: #3d4c4c;
		font-size: 0.98rem;
		line-height: 1.65;
	}

	.notice-text strong {
		color: #004d4c;
		font-weight: 800;
	}

	.info-grid {
		display: grid;
		gap: 16px;
		margin-bottom: 34px;
		text-align: left;
	}

	.info-card {
		display: flex;
		align-items: center;
		gap: 18px;
		padding: 20px 22px;
		border-radius: 22px;
		background: #ffffff;
		border: 1.5px solid #e1ebeb;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
	}

	.info-card-link {
		text-decoration: none;
		color: inherit;
		cursor: pointer;
	}

	.info-card-link:hover {
		background: #ffffff;
		border-color: #006766;
		transform: translateY(-3px);
		box-shadow: 0 14px 32px -10px rgba(0, 77, 76, 0.14);
	}

	.info-card-link:hover .card-arrow {
		transform: translateX(4px);
		color: #004d4c;
	}

	.info-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 16px;
		flex-shrink: 0;
		transition: transform 0.25s ease;
	}

	.office-icon {
		background: linear-gradient(135deg, #004d4c, #006766);
		color: #ffffff;
		box-shadow: 0 8px 16px -4px rgba(0, 77, 76, 0.3);
	}

	.wa-icon {
		background: linear-gradient(135deg, #25d366, #1da851);
		color: #ffffff;
		box-shadow: 0 8px 16px -4px rgba(37, 211, 102, 0.35);
	}

	.info-body {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.info-label {
		font-size: 0.73rem;
		font-weight: 850;
		color: #006766;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 3px;
	}

	.info-title {
		font-size: 1.05rem;
		color: #003635;
		font-weight: 800;
	}

	.info-desc {
		margin: 2px 0 0;
		font-size: 0.86rem;
		color: #5d6d6e;
		line-height: 1.45;
	}

	.card-arrow {
		color: #a0b5b4;
		transition: all 0.2s ease;
	}

	.actions {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.btn {
		display: inline-flex;
		min-height: 52px;
		align-items: center;
		justify-content: center;
		gap: 12px;
		padding: 0 28px;
		border-radius: 18px;
		font-size: 0.96rem;
		font-weight: 850;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-primary {
		background: linear-gradient(135deg, #004d4c 0%, #003635 100%);
		color: #ffffff;
		box-shadow: 0 10px 24px -6px rgba(0, 77, 76, 0.38);
	}

	.btn-primary:hover {
		background: linear-gradient(135deg, #006766 0%, #004d4c 100%);
		transform: translateY(-2px);
		box-shadow: 0 14px 30px -6px rgba(0, 77, 76, 0.48);
	}

	.btn-secondary {
		background: #eef4f4;
		color: #004d4c;
		border: 1px solid #d4e2e2;
	}

	.btn-secondary:hover {
		background: #e2eceb;
		color: #002827;
		border-color: #b5cece;
	}

	@media (max-width: 640px) {
		.page {
			padding-top: 120px;
		}

		.info-card {
			padding: 16px 18px;
			gap: 14px;
		}

		.callout-box {
			padding: 14px 16px;
		}
	}
</style>
