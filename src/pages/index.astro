---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo.png';
import banner1 from '../assets/images/Banner1.png';
import banner2 from '../assets/images/Banner2.jpg';
import banner3 from '../assets/images/Banner3.jpg';
import banner4 from '../assets/images/Banner4.jpg';
import logoMA from '../assets/images/LogoMA.png';
import logoMI from '../assets/images/LogoMI.png';
import logoMTS from '../assets/images/LogoMTS.png';
import logoPAUD from '../assets/images/LogoPAUD.png';
import logoRA from '../assets/images/LogoRA.png';
import logoSTIT from '../assets/images/LogoSTIT.PNG';
import logoULYA from '../assets/images/LogoULYA.png';
import { formatBlogDate, getBlogImageUrl, getLatestBlogs } from '../lib/blogApi';

const banners = [
	{ image: banner1, label: 'Santri Pondok Pesantren Mambaul Hikmah' },
	{ image: banner2, label: "Kegiatan belajar Al-Qur'an santri" },
	{ image: banner4, label: 'Masjid Pondok Pesantren Mambaul Hikmah' },
	{ image: banner3, label: 'Silaturahmi dan pembinaan asatidz' },
];

const missions = [
	'Membiasakan ibadah wajib dan sunnah secara istiqamah.',
	'Membimbing ibadah sesuai ajaran Rasulullah SAW.',
	"Mengajarkan Al-Qur'an dan penguatan kitab salaf (klasik).",
	'Membentuk kebiasaan berperilaku terpuji dan mandiri.',
];

const programs = [
	{
		title: "Al-Qur'an & Tahfidz",
		text: 'Tahsin, tahfidz, murajaah, dan pembiasaan adab mulia bersama Al-Qur’an.',
		icon: 'quran'
	},
	{
		title: 'Pengkajian Kitab Salaf',
		text: 'Penguatan fikih, akidah, akhlak, dan dasar keilmuan Islam klasik.',
		icon: 'book'
	},
	{
		title: 'Bina Akhlak & Adab',
		text: 'Pendampingan karakter melalui adab harian, kehidupan asrama, dan keteladanan.',
		icon: 'heart'
	},
	{
		title: 'Kemandirian Santri',
		text: 'Latihan disiplin, kepemimpinan, organisasi, dan kepedulian sosial.',
		icon: 'star'
	},
];

const units = [
	{
		name: 'STIT Mambaul Hikmah',
		level: 'Perguruan Tinggi',
		logo: logoSTIT,
		desc: 'Sekolah Tinggi Ilmu Tarbiyah',
		link: 'https://pmb-stit.mambaulhikmah.com',
	},
	{ name: 'MA Mambaul Hikmah', level: 'Madrasah Aliyah', logo: logoMA, desc: 'Setara SMA / SMK' },
	{ name: 'MTs Mambaul Hikmah', level: 'Madrasah Tsanawiyah', logo: logoMTS, desc: 'Setara SMP' },
	{ name: 'MI Mambaul Hikmah', level: 'Madrasah Ibtidaiyah', logo: logoMI, desc: 'Setara SD' },
	{ name: 'Ulya Mambaul Hikmah', level: 'Pendidikan Diniyah', logo: logoULYA, desc: 'Pendidikan Keagamaan Diniyah' },
	{ name: 'RA Mambaul Hikmah', level: 'Raudhatul Athfal', logo: logoRA, desc: 'Setara TK' },
	{ name: 'PAUD Mambaul Hikmah', level: 'Pendidikan Usia Dini', logo: logoPAUD, desc: 'Taman Kanak-kanak' },
];

const highlights = [
	{ title: 'Beasiswa Tahfidz', desc: 'Program apresiasi penghafal Qur’an', icon: 'award' },
	{ title: '7 Unit Pendidikan', desc: 'Jenjang PAUD hingga Perguruan Tinggi', icon: 'layers' },
	{ title: 'Pembinaan 24 Jam', desc: 'Pendampingan asrama yang kondusif', icon: 'clock' },
	{ title: 'Kurikulum Terpadu', desc: 'Sinergi agama dan ilmu umum', icon: 'shield' },
];

const latestBlogs = await getLatestBlogs(3);
---

<Layout
	title="Pondok Pesantren Mambaul Hikmah Tegalwangi"
	description="Website profil resmi Pondok Pesantren Mambaul Hikmah Tegalwangi, Talang, Kabupaten Tegal."
>
	<main id="home">
		<!-- HERO SECTION -->
		<section class="hero-section">
			<div class="hero-slider" aria-label="Banner kegiatan Pondok Pesantren Mambaul Hikmah">
				{banners.map((banner, index) => (
					<Image
						src={banner.image}
						alt={banner.label}
						loading={index === 0 ? 'eager' : 'lazy'}
						decoding="async"
						class={`hero-slide slide-${index + 1}`}
					/>
				))}
			</div>

			<div class="hero-overlay"></div>
			<div class="hero-glow glow-left"></div>
			<div class="hero-glow glow-right"></div>

			<div class="hero-container">
				<div class="hero-content">

					<h1 class="hero-title">
						Mendidik Generasi <br />
						<span class="text-gradient">Beriman, Berilmu & Berakhlak</span>
					</h1>

					<p class="hero-subtitle">
						Selamat Datang di Pondok Pesantren Mambaul Hikmah Tegalwangi. Wadah pembinaan karakter generasi Qur'ani yang berwawasan luas dan berakhlakul karimah.
					</p>

					<div class="hero-actions">
						<a class="btn btn-hero-primary" href="/info-pendaftaran">
							<span>Daftar Sekarang</span>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
						<button type="button" class="btn btn-hero-secondary" id="open-video-btn" aria-label="Tonton Video Profil Pesantren">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"></circle>
								<polygon points="10 8 16 12 10 16 10 8"></polygon>
							</svg>
							<span>Jelajahi Profil</span>
						</button>
					</div>
				</div>

				<!-- Floating Motto Badge -->
				<div class="hero-motto-card">
					<div class="motto-logo">
						<Image src={logo} width={52} height={52} alt="Logo Pesantren" loading="eager" />
					</div>
					<div class="motto-info">
						<span class="motto-label">Trilogi Pesantren</span>
						<strong>Ilmu • Amal • Tazkiyah</strong>
					</div>
				</div>
			</div>

			<!-- Quick Highlights Bar -->
			<div class="hero-highlights">
				<div class="highlights-container">
					{highlights.map((item) => (
						<div class="highlight-item">
							<div class="highlight-icon">
								{item.icon === 'award' && (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
								)}
								{item.icon === 'layers' && (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
								)}
								{item.icon === 'clock' && (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
								)}
								{item.icon === 'shield' && (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
								)}
							</div>
							<div class="highlight-text">
								<strong>{item.title}</strong>
								<p>{item.desc}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- PROFIL & LOKASI SECTION -->
		<section class="section profile-section" id="profil">
			<div class="container">
				<div class="profile-grid">
					<div class="profile-media">
						<div class="media-frame">
							<Image src={banner4} alt="Masjid Pondok Pesantren Mambaul Hikmah" loading="lazy" />
							<div class="media-overlay-badge">
								<div class="badge-icon">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
										<circle cx="12" cy="10" r="3"></circle>
									</svg>
								</div>
								<div>
									<strong>Desa Tegalwangi</strong>
									<span>Talang, Kabupaten Tegal</span>
								</div>
							</div>
						</div>
					</div>

					<div class="profile-info">
						<span class="section-tag">Profil & Lokasi Strategis</span>
						<h2>Lingkungan Belajar Asri, Tenang & Mudah Dijangkau</h2>
						<p>
							Pondok Pesantren Mambaul Hikmah berlokasi di Desa Tegalwangi, Kecamatan Talang, Kabupaten Tegal. Terletak di kawasan yang kondusif dan mudah diakses dari berbagai jalur utama, pesantren ini menyelenggarakan pendidikan terpadu dari jenjang dini usia hingga perguruan tinggi.
						</p>

						<div class="stats-cards">
							<div class="stat-card">
								<div class="stat-num">24/7</div>
								<div class="stat-label">Pembinaan Karakter Santri</div>
							</div>
							<div class="stat-card">
								<div class="stat-num">7 Unit</div>
								<div class="stat-label">Pendidikan Berjenjang Terpadu</div>
							</div>
							<div class="stat-card">
								<div class="stat-num">3 Pilar</div>
								<div class="stat-label">Ilmu, Amal, Tazkiyah</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- VISI, MISI & MOTTO -->
		<section class="section vision-section" id="visi">
			<div class="container">
				<div class="section-header text-center">
					<span class="section-tag">Pondasi Keilmuan</span>
					<h2>Visi, Misi & Motto Pesantren</h2>
					<p>Landasan utama dalam mendidik santri menuju insan mulia yang siap mengabdi.</p>
				</div>

				<div class="vision-grid">
					<!-- Visi Card -->
					<div class="vision-card">
						<div class="card-icon-badge">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"></circle>
								<circle cx="12" cy="12" r="6"></circle>
								<circle cx="12" cy="12" r="2"></circle>
							</svg>
						</div>
						<span class="card-label">Visi Utama</span>
						<h3>Membentuk Santri Beriman, Bertakwa, Berilmu, dan Berakhlak Mulia</h3>
						<p>Menjadi pusat keunggulan pendidikan Islam yang melahirkan generasi berkarakter Islami, tangguh, dan bermanfaat bagi masyarakat.</p>
					</div>

					<!-- Misi Card -->
					<div class="vision-card">
						<div class="card-icon-badge">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polyline points="9 11 12 14 22 4"></polyline>
								<path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
							</svg>
						</div>
						<span class="card-label">Misi Pembinaan</span>
						<ul class="mission-list">
							{missions.map((mission) => (
								<li>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>{mission}</span>
								</li>
							))}
						</ul>
					</div>

					<!-- Motto Card -->
					<div class="vision-card motto-card">
						<div class="card-icon-badge">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
							</svg>
						</div>
						<span class="card-label">Motto Pesantren</span>
						<h3 class="motto-title">Ilmu • Amal • Tazkiyah</h3>
						<p>Ilmu yang diamalkan dengan ikhlas, amal yang menyucikan jiwa, dan tazkiyah yang membawa ketenteraman hidup dunia dan akhirat.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- PROGRAM PENDIDIKAN -->
		<section class="section program-section" id="program">
			<div class="container">
				<div class="section-header text-center">
					<span class="section-tag">Kurikulum & Pembinaan</span>
					<h2>Program Unggulan Pesantren</h2>
					<p>Kurikulum terpadu yang memadukan keilmuan Al-Qur'an, tradisi kitab kuning, serta karakter mandiri.</p>
				</div>

				<div class="program-grid">
					{programs.map((prog, idx) => (
						<div class="program-card">
							<div class="prog-number">0{idx + 1}</div>
							<div class="prog-icon">
								{prog.icon === 'quran' && (
									<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
								)}
								{prog.icon === 'book' && (
									<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
								)}
								{prog.icon === 'heart' && (
									<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
								)}
								{prog.icon === 'star' && (
									<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
								)}
							</div>
							<h3>{prog.title}</h3>
							<p>{prog.text}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- UNIT PENDIDIKAN -->
		<section class="section unit-section" id="unit">
			<div class="container">
				<div class="section-header text-center">
					<span class="section-tag">Ekosistem Pendidikan</span>
					<h2>7 Unit Pendidikan Formal & Keagamaan</h2>
					<p>Jalur jenjang pendidikan lengkap yang saling mendukung dari usia dini hingga perguruan tinggi.</p>
				</div>

				<div class="unit-grid">
					{units.map((unit) => {
						const CardTag = unit.link ? 'a' : 'div';
						const linkProps = unit.link ? { href: unit.link, target: '_blank', rel: 'noopener noreferrer' } : {};

						return (
							<CardTag class={`unit-card ${unit.link ? 'unit-card-link' : ''}`} {...linkProps}>
								<div class="unit-logo-box">
									<Image src={unit.logo} alt={`Logo ${unit.name}`} loading="lazy" />
								</div>
								<div class="unit-details">
									<span class="unit-level">{unit.level}</span>
									<h3>
										{unit.name}
										{unit.link && (
											<svg class="unit-external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
												<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
												<polyline points="15 3 21 3 21 9"></polyline>
												<line x1="10" y1="14" x2="21" y2="3"></line>
											</svg>
										)}
									</h3>
									<p>{unit.desc}</p>
								</div>
							</CardTag>
						);
					})}
				</div>
			</div>
		</section>

		<!-- BLOG & BERITA TERBARU -->
		<section class="section blog-section" id="berita">
			<div class="container">
				<div class="section-header flex-header">
					<div>
						<span class="section-tag">Informasi & Kegiatan</span>
						<h2>Berita & Artikel Terbaru</h2>
					</div>
					<a href="/blog" class="btn btn-outline">
						<span>Lihat Semua Berita</span>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
				</div>

				<div class="blog-grid">
					{latestBlogs.length > 0 ? (
						latestBlogs.map((post) => (
							<article class="blog-card">
								<div class="blog-image-box">
									{getBlogImageUrl(post.thumbnail) ? (
										<Image
											src={getBlogImageUrl(post.thumbnail) ?? ''}
											width={800}
											height={450}
											alt={post.title}
											loading="lazy"
										/>
									) : (
										<div class="blog-placeholder">
											<span>MH</span>
										</div>
									)}
									<div class="blog-date-badge">
										{formatBlogDate(post.created_at)}
									</div>
								</div>
								<div class="blog-content">
									<h3>{post.title}</h3>
									<p>{post.excerpt}</p>
									<a href={`/blog/${post.slug}`} class="read-more">
										<span>Baca Selengkapnya</span>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
											<line x1="5" y1="12" x2="19" y2="12"></line>
											<polyline points="12 5 19 12 12 19"></polyline>
										</svg>
									</a>
								</div>
							</article>
						))
					) : (
						<div class="empty-blog-card">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
								<polyline points="14 2 14 8 20 8"></polyline>
								<line x1="16" y1="13" x2="8" y2="13"></line>
								<line x1="16" y1="17" x2="8" y2="17"></line>
								<polyline points="10 9 9 9 8 9"></polyline>
							</svg>
							<h3>Belum ada berita terbaru</h3>
							<p>Artikel dan pengumuman terbaru akan segera diperbarui secara otomatis.</p>
							<a href="/blog" class="btn btn-primary">Buka Arsip Blog</a>
						</div>
					)}
				</div>
			</div>
		</section>

		<script>
			async function updateLatestBlogsHome() {
				const blogGrid = document.querySelector('.blog-section .blog-grid');
				if (!blogGrid) return;

				try {
					const res = await fetch(`https://smart.mambaulhikmah.com/api/blog?limit=3&_t=${Date.now()}`, {
						headers: { Accept: 'application/json' },
						cache: 'no-store',
					});
					if (!res.ok) return;

					const json = await res.json();
					const posts = Array.isArray(json) ? json : json?.data;
					if (!Array.isArray(posts) || posts.length === 0) return;

					function formatDate(value: string) {
						if (!value) return '';
						try {
							return new Intl.DateTimeFormat('id-ID', {
								day: 'numeric',
								month: 'long',
								year: 'numeric',
							}).format(new Date(value));
						} catch {
							return '';
						}
					}

					function getImageUrl(thumb: string | null) {
						if (!thumb) return null;
						if (thumb.startsWith('http://') || thumb.startsWith('https://')) return thumb;
						return `https://smart.mambaulhikmah.com${thumb.startsWith('/') ? '' : '/'}${thumb}`;
					}

					const currentFirstTitle = blogGrid.querySelector('.blog-card h3')?.textContent?.trim();
					if (currentFirstTitle === posts[0].title.trim()) {
						return;
					}

					blogGrid.innerHTML = posts
						.slice(0, 3)
						.map((post: any) => {
							const imgUrl = getImageUrl(post.thumbnail);
							const dateStr = formatDate(post.created_at);

							const imgHtml = imgUrl
								? `<img src="${imgUrl}" alt="${post.title || ''}" loading="lazy" style="width: 100%; aspect-ratio: 16 / 9; object-fit: cover;" />`
								: `<div class="blog-placeholder"><span>MH</span></div>`;

							return `
								<article class="blog-card">
									<div class="blog-image-box">
										${imgHtml}
										<div class="blog-date-badge">${dateStr}</div>
									</div>
									<div class="blog-content">
										<h3>${post.title}</h3>
										<p>${post.excerpt || ''}</p>
										<a href="/blog/${post.slug}" class="read-more">
											<span>Baca Selengkapnya</span>
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
												<line x1="5" y1="12" x2="19" y2="12"></line>
												<polyline points="12 5 19 12 12 19"></polyline>
											</svg>
										</a>
									</div>
								</article>
							`;
						})
						.join('');
				} catch (e) {
					console.warn('[HomeBlog] Live update check skipped:', e);
				}
			}

			updateLatestBlogsHome();

			function initVideoModal() {
				const openBtn = document.getElementById('open-video-btn');
				const closeBtn = document.getElementById('close-video-btn');
				const backdrop = document.getElementById('video-modal-backdrop');
				const modal = document.getElementById('video-modal');
				const iframe = document.getElementById('youtube-iframe') as HTMLIFrameElement | null;

				if (!openBtn || !modal || !iframe) return;

				function openModal() {
					const dataSrc = iframe?.getAttribute('data-src');
					if (iframe && dataSrc) {
						iframe.src = dataSrc;
					}
					modal?.classList.add('active');
					modal?.setAttribute('aria-hidden', 'false');
					document.body.style.overflow = 'hidden';
				}

				function closeModal() {
					modal?.classList.remove('active');
					modal?.setAttribute('aria-hidden', 'true');
					if (iframe) {
						iframe.src = '';
					}
					document.body.style.overflow = '';
				}

				openBtn.addEventListener('click', openModal);
				closeBtn?.addEventListener('click', closeModal);
				backdrop?.addEventListener('click', closeModal);

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && modal?.classList.contains('active')) {
						closeModal();
					}
				});
			}

			initVideoModal();
		</script>

