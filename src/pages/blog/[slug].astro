---
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import {
	formatBlogDate,
	getAllBlogs,
	getBlogBySlug,
	getBlogImageUrl,
	renderBlogContent,
	type BlogPost,
} from '../../lib/blogApi';

export const getStaticPaths = (async () => {
	const blogs = await getAllBlogs();
	const detailedBlogs = await Promise.all(
		blogs.map((post) => getBlogBySlug(post.slug)),
	);

	const validPosts = detailedBlogs.filter((post): post is BlogPost => Boolean(post?.slug));

	return validPosts.map((post, index) => {
		const nextPost = validPosts[(index + 1) % validPosts.length];
		return {
			params: { slug: post.slug },
			props: {
				blog: post,
				nextBlog: nextPost && nextPost.slug !== post.slug ? nextPost : null,
			},
		};
	});
}) satisfies GetStaticPaths;

interface Props {
	blog: BlogPost;
	nextBlog?: BlogPost | null;
}

const { blog, nextBlog } = Astro.props;
const thumbnail = getBlogImageUrl(blog?.thumbnail);
const contentHtml = renderBlogContent(blog?.content);
---

<Layout
	title={`${blog.title} - Pondok Pesantren Mambaul Hikmah`}
	description={blog?.excerpt ?? 'Artikel blog tidak ditemukan.'}
>
	<main class="page">
		<article class="article">
			<header class="article-header">
				<a class="back-link" href="/blog">Kembali ke Blog</a>
				<p class="meta">
					{formatBlogDate(blog.created_at)}
					{blog.category ? ` • ${blog.category}` : ''}
					{blog.author ? ` • ${blog.author}` : ''}
				</p>
				<h1>{blog.title}</h1>
				{blog.excerpt && <p class="excerpt">{blog.excerpt}</p>}
			</header>

			{thumbnail ? (
				<Image
					class="article-image"
					src={thumbnail}
					width={1200}
					height={675}
					alt=""
					loading="eager"
					decoding="async"
				/>
			) : (
				<div class="article-placeholder">MH</div>
			)}

			<div class="article-content" set:html={contentHtml} />

			<footer class="article-footer-actions">
				<a href="/" class="btn btn-action-secondary">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="19" y1="12" x2="5" y2="12"></line>
						<polyline points="12 19 5 12 12 5"></polyline>
					</svg>
					<span>Kembali ke Beranda</span>
				</a>

				{nextBlog ? (
					<a href={`/blog/${nextBlog.slug}`} class="btn btn-action-primary">
						<span>Baca Artikel Lainnya</span>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
				) : (
					<a href="/blog" class="btn btn-action-primary">
						<span>Lihat Semua Artikel</span>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
				)}
			</footer>
		</article>
	</main>
</Layout>

<style>
	.page {
		background: #f8fafa;
	}

	.article {
		max-width: 980px;
		margin: 0 auto;
		padding: 150px 20px 72px;
	}

	.article-header {
		margin-bottom: 28px;
	}

	.back-link {
		display: inline-flex;
		margin-bottom: 24px;
		color: #004d4c;
		font-size: 0.88rem;
		font-weight: 900;
		text-decoration: none;
	}

	.meta {
		margin: 0 0 12px;
		color: #006766;
		font-size: 0.82rem;
		font-weight: 900;
	}

	h1 {
		margin: 0;
		color: #004d4c;
		font-family: Manrope, Inter, ui-sans-serif, system-ui, sans-serif;
		font-size: clamp(2rem, 4.5vw, 3.7rem);
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	.excerpt {
		max-width: 760px;
		color: #465354;
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.article-image,
	.article-placeholder {
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 28px;
	}

	.article-image {
		object-fit: cover;
	}

	.article-placeholder {
		display: grid;
		place-items: center;
		background: linear-gradient(135deg, #004d4c, #006766);
		color: #ffffff;
		font-size: 2.4rem;
		font-weight: 950;
	}

	.article-content {
		margin-top: 34px;
		padding: clamp(24px, 5vw, 44px);
		border-radius: 28px;
		background: #ffffff;
		color: #263233;
		line-height: 1.85;
	}

	.article-content :global(h2),
	.article-content :global(h3) {
		margin-top: 1.5em;
		color: #004d4c;
		line-height: 1.2;
	}

	.article-content :global(h2) {
		font-size: clamp(1.55rem, 3vw, 2.1rem);
	}

	.article-content :global(h3) {
		font-size: clamp(1.25rem, 2.4vw, 1.55rem);
	}

	.article-content :global(p) {
		margin: 0 0 1.1em;
	}

	.article-content :global(blockquote) {
		margin: 1.5em 0;
		padding: 18px 22px;
		border-left: 5px solid #c89b3c;
		border-radius: 0 14px 14px 0;
		background: #f8fafa;
		color: #263233;
		font-style: italic;
	}

	.article-content :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.article-content :global(.arabic-text) {
		margin: 1.4em 0;
		color: #102728;
		font-size: clamp(1.35rem, 3vw, 1.9rem);
		line-height: 2.15;
		text-align: right;
	}

	.article-content :global(.article-citation) {
		color: #657172;
		font-size: 0.92rem;
		font-style: italic;
	}

	.article-content :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 18px;
	}

	/* ARTICLE FOOTER ACTIONS (KIRI & KANAN) */
	.article-footer-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 40px;
		padding-top: 28px;
		border-top: 1px solid #e0ebeb;
	}

	.btn-action-primary,
	.btn-action-secondary {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 14px 24px;
		border-radius: 16px;
		font-size: 0.92rem;
		font-weight: 850;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.btn-action-primary {
		background: #004d4c;
		color: #ffffff;
		box-shadow: 0 8px 20px -6px rgba(0, 77, 76, 0.3);
	}

	.btn-action-primary:hover {
		background: #003635;
		transform: translateY(-2px);
		box-shadow: 0 12px 24px -6px rgba(0, 77, 76, 0.4);
	}

	.btn-action-secondary {
		background: #ffffff;
		color: #004d4c;
		border: 1.5px solid #d4e2e2;
	}

	.btn-action-secondary:hover {
		background: #eef4f4;
		border-color: #004d4c;
		transform: translateY(-2px);
	}

	@media (max-width: 640px) {
		.article-footer-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.btn-action-primary,
		.btn-action-secondary {
			justify-content: center;
			width: 100%;
		}
	}
</style>
