---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Pondok Pesantren Mambaul Hikmah Tegalwangi',
	description = 'Website Pondok Pesantren Mambaul Hikmah Tegalwangi - Talang Tegal.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="shortcut icon" type="image/png" href="/logo.png" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800;900&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
		<WhatsAppCTA />
	</body>
</html>

<style>
	html,
	body {
		width: 100%;
		min-height: 100%;
	}
</style>
